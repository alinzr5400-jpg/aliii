# Copy values into backend/.env

PORT=3000
NETWORK=testnet
TON_RPC=https://testnet.toncenter.com/api/v2/jsonRPC
# Free key from https://t.me/tonapibot — strongly recommended on Render
TON_API_KEY=
TON_COLLECTION_ADDRESS=

# Pinata / IPFS (dynamic metadata still served by GET /nft/:id)
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# On Render, RENDER_EXTERNAL_URL is set automatically → metadata images
# use https://YOUR-SERVICE.onrender.com/media/ipfs/... (Tonkeeper-friendly).
# Optional override:
# PUBLIC_BASE_URL=https://alamdar-backend1.onrender.com
# MEDIA_PROXY=0
HIDDEN_IMAGE_CID=bafybeigsk72nzcyweotcgzxzzoryhfc6azdqro66xbsayyuiembksur3je
# optional override of full URL:
# HIDDEN_IMAGE_URL=https://gateway.pinata.cloud/ipfs/bafybeigsk72nzcyweotcgzxzzoryhfc6azdqro66xbsayyuiembksur3je
IPFS_LEGENDARY_CID=bafybeid5gyufb36n5iq7jfuylrqpvxefmej24kyzzvrhp7fmpkxdxsqnrq
IPFS_MYTHIC_CID=bafybeiera5opfkep6tyqqfktdq7ez33cgxnyesg6splmf7jwne2i5al3uu
IPFS_UNIQUE_CID=bafybeic63nnkc2gzhh3ylui66uivoroxja572zhrraavmkcjpkc74cck4a
# legacy aliases (optional):
# IPFS_RARE_CID=
# IPFS_COMMON_CID=

# Sale
MINT_PRICE=0.5
MIN_BUY=2
MAX_BUY=10
SALE_START_AT=
SALE_MODE=admin
PAYMENT_ADDRESS=0QDn0jKgDuuDhMgBvtllmmmrE21gM3v3copY3SN9PUUv9fui
CORS_ORIGIN=https://radiant-dusk-c1027e.netlify.app

# Required for SALE_MODE=admin confirm/mint
ADMIN_MNEMONIC=
ADMIN_WALLET_VERSION=v5r1

# Required for POST /admin/reveal (header x-admin-secret)
ADMIN_API_SECRET=

# Persistent SQLite (Render Disk mount at /var/data)
# DATA_DIR=/var/data
# DB_PATH=/var/data/alamdar.db
