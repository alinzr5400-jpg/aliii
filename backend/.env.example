# Copy values into backend/.env

PORT=3000
NETWORK=testnet
TON_RPC=https://testnet.toncenter.com/api/v2/jsonRPC
TON_COLLECTION_ADDRESS=kQBJukUFjWoPUtoQGjpxIzRH-duuTxAaMkRG61eA3Ktwqxtl

# Sale
MINT_PRICE=0.5
MIN_BUY=1
MAX_BUY=10
# ISO datetime or leave empty to open immediately
SALE_START_AT=
# admin = pay treasury then backend mints (works with current contract)
# public = PublicMint on collection (needs rebuild + redeploy)
SALE_MODE=admin
# Defaults to on-chain adminAddress if empty
PAYMENT_ADDRESS=
HIDDEN_IMAGE_URL=https://xxx.ir/hidden.png
CORS_ORIGIN=http://localhost:5173

# Required for SALE_MODE=admin confirm/mint
# Must be the collection admin wallet mnemonic
ADMIN_MNEMONIC=
# Wallet version of admin mnemonic wallet: v5r1 (default) or v4
ADMIN_WALLET_VERSION=v5r1
