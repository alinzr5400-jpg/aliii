# Copy values into backend/.env

PORT=3000
NETWORK=testnet
TON_RPC=https://testnet.toncenter.com/api/v2/jsonRPC
# Free key from https://t.me/tonapibot — strongly recommended on Render
TON_API_KEY=
TON_COLLECTION_ADDRESS=

# After reveal: point these at real HTTPS/IPFS (Pinata) URLs — do not leave xxx.ir in production
# HIDDEN_IMAGE_URL=https://gateway.pinata.cloud/ipfs/...
# Collection baseUri is on-chain; NFT JSON is served by GET /nft/:id from this backend


# Sale
MINT_PRICE=0.5
MIN_BUY=2
MAX_BUY=10
SALE_START_AT=
SALE_MODE=admin
PAYMENT_ADDRESS=0QDn0jKgDuuDhMgBvtllmmmrE21gM3v3copY3SN9PUUv9fui
HIDDEN_IMAGE_URL=https://xxx.ir/hidden.png
CORS_ORIGIN=https://radiant-dusk-c1027e.netlify.app

# Required for SALE_MODE=admin confirm/mint
ADMIN_MNEMONIC=
ADMIN_WALLET_VERSION=v5r1
